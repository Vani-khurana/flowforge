# FlowForge Backend Environment Configuration

# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secrets
# IMPORTANT: In production, generate a secure random string with at least 32 characters.
JWT_SECRET=super-secret-flowforge-jwt-token-key-change-in-production
JWT_EXPIRES_IN=7d

# Role-Based Demo Switch Security
# Set to 'false' in production to strictly disable /api/auth/switch-role
ENABLE_DEMO_ROLE_SWITCH=true

# Database Persistence (Optional)
# If left empty, FlowForge automatically persists state to backend/data/store.json
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowforge?schema=public"
